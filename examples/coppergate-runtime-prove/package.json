{
  "name": "@opp/example-coppergate-runtime-prove",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prove": "node --import tsx src/prove.ts",
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@opp/client": "workspace:*",
    "@opp/parse": "workspace:*",
    "@opp/schema": "workspace:*",
    "@opp/verify": "workspace:*"
  },
  "devDependencies": {
    "@opp/typescript-config": "workspace:*",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
