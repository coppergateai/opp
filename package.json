{
  "name": "opp",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "assert:open-program": "node scripts/assert-open-program.mjs",
    "assert:lockfile": "node scripts/assert-lockfile.mjs",
    "prove:coppergate-runtime": "pnpm --filter @opp/example-coppergate-runtime-prove prove",
    "smoke:hosted-api": "node scripts/smoke-hosted-api.mjs",
    "bundle:api": "node scripts/bundle-api.mjs"
  },
  "dependencies": {
    "@opp/api": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
